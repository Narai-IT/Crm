{
  "name": "group-crm-server",
  "version": "0.1.0",
  "private": true,
  "description": "Group CRM backend: multi-brand LINE OA membership on PostgreSQL",
  "type": "module",
  "engines": { "node": ">=20.6" },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "dev": "node --env-file=.env --watch src/index.js",
    "db:migrate": "node --env-file=.env scripts/migrate.js",
    "db:seed": "node --env-file=.env scripts/seed.js",
    "db:reset": "node --env-file=.env scripts/migrate.js --reset && node --env-file=.env scripts/seed.js",
    "db:clear-demo": "node --env-file=.env scripts/clear-demo.js",
    "test": "node --env-file=.env --test test/*.test.js"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
