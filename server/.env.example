# ---------- ฐานข้อมูล ----------
DATABASE_URL=postgres://crm_app:change-me@localhost:5432/crm
# ฐานข้อมูลแยกสำหรับ npm test (ถูกล้างทุกครั้ง) · เว้นว่างได้ถ้าไม่รันทดสอบ
TEST_DATABASE_URL=postgres://crm_app:change-me@localhost:5432/crm_test

# ---------- เว็บเซิร์ฟเวอร์ ----------
PORT=3000
# ใช้เซ็น token หลังบ้าน และ QR สมาชิก · สุ่มใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-string

# 1 = โหมดพัฒนา/เดโม: เปิด /api/dev/*, ให้หน้าเดโมสวมบท LINE user และพนักงานได้โดยไม่ล็อกอิน, OTP แสดงบนจอ
# ตั้งเป็น 0 ก่อนเปิดใช้จริงเสมอ
DEV_MODE=1

# ---------- LINE ----------
# LINE Login channel ที่ผูกกับ LIFF (ใช้ตรวจ ID token จาก LIFF)
LINE_LOGIN_CHANNEL_ID=
LIFF_ID=
# Messaging API ของแต่ละ OA · เว้นว่างได้ระหว่างพัฒนา (ระบบจะบันทึกข้อความไว้แต่ไม่ส่งจริง)
LINE_NARAI_SECRET=
LINE_NARAI_TOKEN=
LINE_WAKAME_SECRET=
LINE_WAKAME_TOKEN=
LINE_HUMLAI_SECRET=
LINE_HUMLAI_TOKEN=
